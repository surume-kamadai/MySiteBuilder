<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MySiteBuilder.ViewModels"
        xmlns:local="using:MySiteBuilder.Controls"
        xmlns:docking="using:MySiteBuilder.Controls.Docking"
        xmlns:models="using:MySiteBuilder.Core.Models"
        xmlns:dock="using:MySiteBuilder.ViewModels.Docking"
        x:Class="MySiteBuilder.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="My Site Builder"
        Width="1280" Height="800">

    <Window.DataTemplates>

        <!-- ツールパネル -->
        <DataTemplate DataType="dock:ToolsPanel">
            <ScrollViewer DataContext="{Binding Editor}" Background="#2D2D30">
                <StackPanel x:DataType="vm:MainWindowViewModel" Spacing="3" Margin="0,0,0,6">
                    <StackPanel.Styles>
                        <Style Selector="Button.tool">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Margin" Value="8,1"/>
                            <Setter Property="Padding" Value="10,6"/>
                        </Style>
                    </StackPanel.Styles>
                    <Button Classes="tool" Tag="Label"       Click="OnAddClick">🅣 テキスト</Button>
                    <Button Classes="tool" Tag="Button"      Click="OnAddClick">🔘 ボタン</Button>
                    <Button Classes="tool" Tag="TextInput"   Click="OnAddClick">⌨ 入力欄</Button>
                    <Button Classes="tool" Tag="Image"       Click="OnAddClick">🖼 画像</Button>
                    <Button Classes="tool" Tag="Rect"        Click="OnAddClick">▭ 四角</Button>
                    <Button Classes="tool" Tag="Circle"      Click="OnAddClick">⬤ 丸</Button>
                    <Button Classes="tool" Tag="Triangle"    Click="OnAddClick">▲ 三角</Button>
                    <Button Classes="tool" Tag="Slider"      Click="OnAddClick">🎞 スライダー</Button>
                    <Button Classes="tool" Tag="ArticleGrid" Click="OnAddClick">▦ 記事グリッド</Button>
                    <Button Classes="tool" Tag="Accordion"   Click="OnAddClick">≡ アコーディオン</Button>
                    <Button Classes="tool" Click="OnDeleteClick" IsEnabled="{Binding HasSelection}">🗑 選択を削除</Button>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- レイヤー（要素一覧＋重ね順/グループ）パネル -->
        <DataTemplate DataType="dock:ExplorerPanel">
            <Grid DataContext="{Binding Editor}" Background="#2D2D30">
                <Grid x:DataType="vm:MainWindowViewModel" Margin="8,6" RowDefinitions="Auto,Auto,*">
                    <WrapPanel Grid.Row="0">
                        <WrapPanel.Styles>
                            <Style Selector="Button.z">
                                <Setter Property="Margin" Value="0,0,3,3"/>
                                <Setter Property="Padding" Value="6,3"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                        </WrapPanel.Styles>
                        <Button Classes="z" Click="OnBringToFrontClick" IsEnabled="{Binding HasSelection}">⤒最前</Button>
                        <Button Classes="z" Click="OnBringForwardClick" IsEnabled="{Binding HasSelection}">▲前へ</Button>
                        <Button Classes="z" Click="OnSendBackwardClick" IsEnabled="{Binding HasSelection}">▼後へ</Button>
                        <Button Classes="z" Click="OnSendToBackClick" IsEnabled="{Binding HasSelection}">⤓最背</Button>
                    </WrapPanel>
                    <WrapPanel Grid.Row="1">
                        <Button Click="OnGroupClick" IsEnabled="{Binding CanGroup}" Padding="6,3" FontSize="11" Margin="0,0,3,4">▣ グループ化</Button>
                        <Button Click="OnUngroupClick" IsEnabled="{Binding CanUngroup}" Padding="6,3" FontSize="11" Margin="0,0,3,4">解除</Button>
                    </WrapPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding ExplorerItems}"
                             SelectedItem="{Binding ExplorerSelected, Mode=TwoWay}"
                             Loaded="OnLayerListLoaded"
                             Background="#26262A" Margin="0,4,0,0">
                        <ListBox.Styles>
                            <!-- 行の余白・角丸・選択/ホバーの見やすさ -->
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="2,1"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                            <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#0E639C"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SiteElement">
                                <Grid ColumnDefinitions="26,*" Margin="6,5"
                                      Opacity="{Binding Properties.Visible, Converter={x:Static local:VisibleOpacityConverter.Instance}}">
                                    <!-- 種類アイコン -->
                                    <TextBlock Grid.Column="0" FontSize="15" VerticalAlignment="Center" TextAlignment="Center"
                                               Text="{Binding Type, Converter={x:Static local:ElementTypeIconConverter.Instance}}"/>
                                    <!-- 名前（主役）＋種類ラベル（補足） -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{Binding Properties.Name}" Foreground="#F0F0F0" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ., Converter={x:Static local:GroupChildCountConverter.Instance}}"
                                                       Foreground="#8AA9C0" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Type, Converter={x:Static local:ElementTypeLabelConverter.Instance}}"
                                                   Foreground="#7C7C82" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ページ（縦並びのエクスプローラー） -->
        <DataTemplate DataType="dock:PagesPanel">
            <Grid DataContext="{Binding Editor}" Background="#2D2D30">
                <Grid x:DataType="vm:MainWindowViewModel" Margin="8,6" RowDefinitions="Auto,*,Auto">
                    <!-- 追加/削除ツールバー -->
                    <WrapPanel Grid.Row="0">
                        <WrapPanel.Styles>
                            <Style Selector="Button.p">
                                <Setter Property="Margin" Value="0,0,3,3"/>
                                <Setter Property="Padding" Value="6,3"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                        </WrapPanel.Styles>
                        <Button Classes="p" Click="OnAddPageClick">＋ ページ</Button>
                        <Button Classes="p" Click="OnAddFolderClick">＋ フォルダ</Button>
                        <Button Classes="p" Click="OnDeletePageClick" IsEnabled="{Binding CanDeletePage}">🗑 削除</Button>
                    </WrapPanel>

                    <!-- ページ一覧（縦リスト・選択ハイライト） -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding PageTabs}"
                             SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                             Loaded="OnPageListLoaded"
                             Background="#26262A" Margin="0,4">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="2,1"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                            <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#0E639C"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SitePage">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,5">
                                    <TextBlock Text="📄" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Foreground="#F0F0F0" FontSize="13"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 選択ページの設定（名前・フォルダ） -->
                    <StackPanel Grid.Row="2" Spacing="2">
                        <TextBlock Text="ページ名" Foreground="#BBBBBB" FontSize="11" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding ActivePageName}" Padding="6,4"/>
                        <TextBlock Text="フォルダ" Foreground="#BBBBBB" FontSize="11" Margin="0,4,0,0"/>
                        <ComboBox ItemsSource="{Binding FolderNames}"
                                  SelectedItem="{Binding ActivePageFolderName, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- キャンバス（ドキュメント）パネル -->
        <DataTemplate DataType="dock:CanvasPanel">
            <ScrollViewer DataContext="{Binding Editor}" Background="#3C3C40"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Border x:DataType="vm:MainWindowViewModel" Margin="30"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BoxShadow="0 0 30 0 #60000000">
                    <local:MyCanvasControl Editor="{Binding}"
                                           Width="{Binding CanvasWidth}"
                                           Height="{Binding CanvasHeight}"/>
                </Border>
            </ScrollViewer>
        </DataTemplate>

        <!-- プロパティ（Inspector）パネル -->
        <DataTemplate DataType="dock:InspectorPanel">
            <ScrollViewer DataContext="{Binding Editor}" Background="#2D2D30">
                <StackPanel x:DataType="vm:MainWindowViewModel" Margin="12" Spacing="6">
                    <StackPanel.Styles>
                        <Style Selector="TextBlock.label">
                            <Setter Property="Foreground" Value="#BBBBBB"/>
                            <Setter Property="Margin" Value="0,6,0,0"/>
                        </Style>
                        <Style Selector="TextBox">
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                    </StackPanel.Styles>

                    <StackPanel IsVisible="{Binding HasSelection}" Spacing="2">
                        <TextBlock Classes="label" Text="種類"/>
                        <TextBlock Text="{Binding SelType}" Foreground="White" FontWeight="Bold"/>

                        <TextBlock Classes="label" Text="名前"/>
                        <TextBox Text="{Binding SelName}"/>

                        <TextBlock Classes="label" Text="テキスト / 画像URL"/>
                        <TextBox Text="{Binding SelText}" AcceptsReturn="True" MaxHeight="80" TextWrapping="Wrap"/>

                        <Button IsVisible="{Binding IsImageSelected}" Click="OnPickImageClick"
                                HorizontalAlignment="Stretch" Margin="0,4,0,0" Padding="8,6">🖼 画像ファイルを選択...</Button>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Classes="label" Text="X"/>
                                <TextBox Text="{Binding SelX}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Classes="label" Text="Y"/>
                                <TextBox Text="{Binding SelY}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Classes="label" Text="幅"/>
                                <TextBox Text="{Binding SelW}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Classes="label" Text="高さ"/>
                                <TextBox Text="{Binding SelH}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Classes="label" Text="背景色 (#hex)"/>
                        <TextBox Text="{Binding SelBgColor}"/>
                        <TextBlock Classes="label" Text="文字色 (#hex)"/>
                        <TextBox Text="{Binding SelColor}"/>
                        <TextBlock Classes="label" Text="文字サイズ"/>
                        <TextBox Text="{Binding SelFontSize}"/>
                        <TextBlock Classes="label" Text="リンク先 (route)"/>
                        <TextBox Text="{Binding SelRoute}"/>

                        <!-- レイヤースタイル（塗りグラデ/境界線/角丸） -->
                        <StackPanel IsVisible="{Binding IsLayerStyleSelected}" Spacing="2">
                            <Border Height="1" Background="#444" Margin="0,8"/>
                            <TextBlock Text="レイヤースタイル" Foreground="White" FontWeight="Bold"/>

                            <TextBlock Classes="label" Text="角丸 (px)"/>
                            <TextBox Text="{Binding SelCornerRadius}"/>

                            <CheckBox IsChecked="{Binding SelStrokeOn}" Content="境界線" Foreground="#DDDDDD" Margin="0,4,0,0"/>
                            <Grid ColumnDefinitions="*,*" IsVisible="{Binding SelStrokeOn}" Margin="0,2,0,0">
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Classes="label" Text="太さ"/>
                                    <TextBox Text="{Binding SelStrokeWidth}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Classes="label" Text="色 (#hex)"/>
                                    <TextBox Text="{Binding SelStrokeColor}"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox IsChecked="{Binding SelGradientOn}" Content="塗りグラデーション" Foreground="#DDDDDD" Margin="0,4,0,0"/>
                            <StackPanel IsVisible="{Binding SelGradientOn}" Spacing="2" Margin="0,2,0,0">
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Classes="label" Text="種類"/>
                                        <ComboBox ItemsSource="{Binding GradientTypeOptions}"
                                                  SelectedItem="{Binding SelGradientType, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Classes="label" Text="方向"/>
                                        <ComboBox ItemsSource="{Binding GradientDirOptions}"
                                                  SelectedItem="{Binding SelGradientDir, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Classes="label" Text="色1"/>
                                        <TextBox Text="{Binding SelGradientC1}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Classes="label" Text="色2"/>
                                        <TextBox Text="{Binding SelGradientC2}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- ボタンのフォーム設定 -->
                        <StackPanel IsVisible="{Binding IsButtonSelected}" Spacing="2">
                            <Border Height="1" Background="#444" Margin="0,8"/>
                            <TextBlock Text="ボタン設定" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Classes="label" Text="役割 (role)"/>
                            <ComboBox ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding SelRole, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            <TextBlock Classes="label" Text="送信メソッド (静的の送信ボタン用)"/>
                            <ComboBox ItemsSource="{Binding MethodOptions}"
                                      SelectedItem="{Binding SelMethod, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            <TextBlock Classes="label" Text="送信完了メッセージ（空で遷移のみ）"/>
                            <TextBox Text="{Binding SelSuccessMessage}"/>
                            <TextBlock Text="※ role=submit にすると、そのページ全体が &lt;form&gt; になり、リンク先がフォーム送信先(Googleフォーム等)になります。"
                                       Foreground="#888888" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 入力欄のフォーム設定 -->
                        <StackPanel IsVisible="{Binding IsTextInputSelected}" Spacing="2">
                            <Border Height="1" Background="#444" Margin="0,8"/>
                            <TextBlock Text="入力欄設定" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Classes="label" Text="name 属性（送信キー）"/>
                            <TextBox Text="{Binding SelInputName}"/>
                            <TextBlock Classes="label" Text="種類"/>
                            <ComboBox ItemsSource="{Binding InputTypeOptions}"
                                      SelectedItem="{Binding SelInputType, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            <CheckBox IsChecked="{Binding SelRequired}" Content="必須項目" Foreground="#DDDDDD" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- スライダーのアイテム編集 -->
                        <StackPanel IsVisible="{Binding IsSliderSelected}" Spacing="2">
                            <Border Height="1" Background="#444" Margin="0,8"/>
                            <TextBlock Text="スライダー設定" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Classes="label" Text="エフェクト"/>
                            <ComboBox ItemsSource="{Binding SliderEffectOptions}"
                                      SelectedItem="{Binding SliderEffect, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            <CheckBox IsChecked="{Binding SliderAutoplay}" Content="自動再生" Foreground="#DDDDDD"/>
                            <CheckBox IsChecked="{Binding SliderNavigation}" Content="左右矢印" Foreground="#DDDDDD"/>
                            <TextBlock Classes="label" Text="スライド一覧"/>
                            <ItemsControl ItemsSource="{Binding SliderItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SlideItem">
                                        <Border Background="#26262A" CornerRadius="4" Padding="6" Margin="0,3">
                                            <StackPanel Spacing="3">
                                                <TextBox PlaceholderText="タイトル" Text="{Binding Title}"/>
                                                <TextBox PlaceholderText="本文" Text="{Binding Text}"/>
                                                <TextBox PlaceholderText="画像URL / data:image" Text="{Binding Image}"/>
                                                <TextBox PlaceholderText="リンク種別: none / url / page" Text="{Binding LinkType}"/>
                                                <TextBox PlaceholderText="リンク先" Text="{Binding Link}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Click="OnPickSlideImageClick" Padding="6,3">画像...</Button>
                                                    <Button Click="OnRemoveSlideClick" Padding="6,3">削除</Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Click="OnAddSlideClick" HorizontalAlignment="Stretch" Margin="0,4">＋ スライド追加</Button>
                        </StackPanel>

                        <!-- 記事グリッドのアイテム編集 -->
                        <StackPanel IsVisible="{Binding IsGridSelected}" Spacing="2">
                            <Border Height="1" Background="#444" Margin="0,8"/>
                            <TextBlock Text="記事グリッド設定" Foreground="White" FontWeight="Bold"/>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Classes="label" Text="列数"/>
                                    <TextBox Text="{Binding GridColumns}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Classes="label" Text="間隔(px)"/>
                                    <TextBox Text="{Binding GridGap}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Classes="label" Text="カード一覧"/>
                            <ItemsControl ItemsSource="{Binding GridItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:GridItem">
                                        <Border Background="#26262A" CornerRadius="4" Padding="6" Margin="0,3">
                                            <StackPanel Spacing="3">
                                                <TextBox PlaceholderText="タイトル" Text="{Binding Title}"/>
                                                <TextBox PlaceholderText="本文" Text="{Binding Text}"/>
                                                <TextBox PlaceholderText="画像URL / data:image" Text="{Binding Image}"/>
                                                <TextBox PlaceholderText="リンク種別: none / url / page" Text="{Binding LinkType}"/>
                                                <TextBox PlaceholderText="リンク先" Text="{Binding Link}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Click="OnPickCardImageClick" Padding="6,3">画像...</Button>
                                                    <Button Click="OnRemoveCardClick" Padding="6,3">削除</Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Click="OnAddCardClick" HorizontalAlignment="Stretch" Margin="0,4">＋ カード追加</Button>
                        </StackPanel>

                        <!-- アコーディオンのアイテム編集 -->
                        <StackPanel IsVisible="{Binding IsAccordionSelected}" Spacing="2">
                            <Border Height="1" Background="#444" Margin="0,8"/>
                            <TextBlock Text="アコーディオン設定" Foreground="White" FontWeight="Bold"/>
                            <CheckBox IsChecked="{Binding AccordionOpenFirst}" Content="最初の項目を開いておく" Foreground="#DDDDDD"/>
                            <TextBlock Classes="label" Text="Q&amp;A 一覧"/>
                            <ItemsControl ItemsSource="{Binding AccordionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AccordionItem">
                                        <Border Background="#26262A" CornerRadius="4" Padding="6" Margin="0,3">
                                            <StackPanel Spacing="3">
                                                <TextBox PlaceholderText="質問（見出し）" Text="{Binding Title}"/>
                                                <TextBox PlaceholderText="回答（本文）" Text="{Binding Content}"
                                                         AcceptsReturn="True" MaxHeight="80" TextWrapping="Wrap"/>
                                                <Button Click="OnRemoveQaClick" Padding="6,3" HorizontalAlignment="Left">削除</Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Click="OnAddQaClick" HorizontalAlignment="Stretch" Margin="0,4">＋ Q&amp;A 追加</Button>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock IsVisible="{Binding !HasSelection}"
                               Text="要素を選択すると、ここで編集できます。"
                               Foreground="#888888" TextWrapping="Wrap" Margin="0,8"/>

                    <!-- プロジェクト / ページ設定 -->
                    <Border Height="1" Background="#444" Margin="0,10"/>
                    <Expander Header="⚙ プロジェクト設定">
                        <StackPanel Spacing="2" Margin="0,4">
                            <TextBlock Classes="label" Text="プロジェクト名（出力フォルダ名）"/>
                            <TextBox Text="{Binding ProjName}"/>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Classes="label" Text="キャンバス幅"/>
                                    <TextBox Text="{Binding CanvasWEdit}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Classes="label" Text="キャンバス高さ"/>
                                    <TextBox Text="{Binding CanvasHEdit}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Classes="label" Text="サイト背景色 (#hex)"/>
                            <TextBox Text="{Binding ProjSiteBgColor}"/>
                            <TextBlock Classes="label" Text="サイト名 (SEO)"/>
                            <TextBox Text="{Binding ProjSiteName}"/>
                            <TextBlock Classes="label" Text="言語 (lang)"/>
                            <TextBox Text="{Binding ProjLang}"/>
                            <TextBlock Classes="label" Text="サイト共通の説明 (description)"/>
                            <TextBox Text="{Binding ProjDescription}" AcceptsReturn="True" MaxHeight="70" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="📄 このページの設定">
                        <StackPanel Spacing="2" Margin="0,4">
                            <TextBlock Classes="label" Text="ページ背景色 (#hex, 空でサイト共通)"/>
                            <TextBox Text="{Binding PageBg}"/>
                            <TextBlock Classes="label" Text="ページタイトル (SEO)"/>
                            <TextBox Text="{Binding PageSeoTitle}"/>
                            <TextBlock Classes="label" Text="ページの説明 (SEO)"/>
                            <TextBox Text="{Binding PageSeoDescription}" AcceptsReturn="True" MaxHeight="70" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

    </Window.DataTemplates>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 上部ツールバー: ファイル操作・出力・レイアウト -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#252528" Spacing="6">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="Padding" Value="10,6"/>
                </Style>
            </StackPanel.Styles>
            <Button Click="OnOpenClick">📂 開く</Button>
            <Button Click="OnSaveClick">💾 保存</Button>
            <Border Width="1" Background="#444" Margin="4,6"/>
            <Button Click="OnUndoClick" IsEnabled="{Binding CanUndo}">↶ 元に戻す</Button>
            <Button Click="OnRedoClick" IsEnabled="{Binding CanRedo}">↷ やり直し</Button>
            <Border Width="1" Background="#444" Margin="4,6"/>
            <Button Click="OnExportStaticClick">🌐 静的サイト出力</Button>
            <Button Click="OnExportLaravelClick">⚙️ Laravel出力</Button>
            <Border Width="1" Background="#444" Margin="4,6"/>
            <Button Click="OnResetLayoutClick">🗔 レイアウト初期化</Button>
        </StackPanel>

        <!-- ドッキング領域（自作エンジン）: ドラッグで再配置・分割・タブ化・フロート化 -->
        <docking:DockArea Grid.Row="1" Layout="{Binding DockLayout}"/>

        <!-- 下部ステータスバー -->
        <Border Grid.Row="2" Background="#007acc" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White"/>
        </Border>
    </Grid>
</Window>
