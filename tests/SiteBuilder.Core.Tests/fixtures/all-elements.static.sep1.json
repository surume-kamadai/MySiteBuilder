      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>トップ&lt;ページ&gt; | 鎌代スタジオ</title>\n    <meta name=\"description\" content=\"ページ個別の&quot;説明&quot;\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:title\" content=\"トップ&lt;ページ&gt; | 鎌代スタジオ\">\n    <meta property=\"og:description\" content=\"ページ個別の&quot;説明&quot;\">\n    <meta property=\"og:image\" content=\"https://example.com/site-og.png\">\n    <meta property=\"og:site_name\" content=\"鎌代スタジオ\">\n    <meta name=\"twitter:card\" content=\"summary_large_image\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Yusei+Magic&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"css/common.css\">\n    <link rel=\"stylesheet\" href=\"css/index.css\">\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css\" />\n    <style>:root { --swiper-theme-color: #ffffff; }</style>\n</head>\n<body style=\"margin: 0; background-color: #1e293b;\">\n\n<div class=\"site-canvas\">\n<form action=\"https://formspree.io/f/abc\" method=\"POST\" target=\"ksb_form_target\" onsubmit=\"setTimeout(function(){var s=document.getElementById('ksb-form-success');if(s)s.style.display='flex';},400);\">\n    \n    <div id=\"lbl1\" class=\"el-lbl1 anim-fadeup\" style=\"position: absolute; box-sizing: border-box; background-color: transparent; color: #ffcc00; text-align: center; font-family: Noto Sans JP; text-shadow: 5px 5px 0 rgba(0,0,0,0.45); display: block; overflow: hidden; text-shadow: 5px 5px 0 rgba(0,0,0,0.45); font-weight: bold; font-style: italic; text-decoration: underline; letter-spacing: 2px; line-height: 1.4;\"><span style=\"background: linear-gradient(135deg, #ff6ec4, #7873f5); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;\">見出し &amp; &lt;ロゴ&gt;</span></div>\n    \n    <div id=\"rect1\" class=\"el-rect1\" style=\"position: absolute; box-sizing: border-box; background: linear-gradient(90deg, #4facfe, #00f2fe); color: inherit; text-align: left; font-family: sans-serif;  border: 3px solid #ffffff; border-radius: 12px;\"></div>\n    \n    <div id=\"circ1\" class=\"el-circ1\" style=\"position: absolute; box-sizing: border-box; background-color: #e91e63; color: inherit; text-align: left; font-family: sans-serif; box-shadow: 4px 6px 12px 1px rgba(34, 0, 51, 0.5), 0 0 20px 2px rgba(0, 208, 255, 0.8); border-radius: 50%;\"></div>\n    \n    <div id=\"tri1\" class=\"el-tri1\" style=\"position: absolute; box-sizing: border-box;\"><div style=\"position: absolute; width: 100%; height: 100%; box-sizing: border-box; clip-path: polygon(50% 0%, 100% 100%, 0% 100%); background: radial-gradient(circle, #f7971e, #ffd200);\"></div></div>\n    \n    <div id=\"warp1\" class=\"el-warp1\" style=\"position: absolute; left: 60%; top: 15.714285714285714%; width: 17.77777777777778%; height: 17.142857142857142%; background-color: #22c55e; clip-path: polygon(6.25% 0.00%, 100.00% 25.00%, 75.00% 100.00%, 0.00% 75.00%); box-shadow: inset 2px 2px 6px rgba(0, 51, 0, 0.4);\"></div>\n    \n    <div id=\"img1\" class=\"el-img1\" style=\"position: absolute; box-sizing: border-box; background: linear-gradient(180deg, #000000, #ffffff); color: inherit; text-align: left; font-family: sans-serif; background:none; overflow:hidden;\"><a href=\"about.html\" style=\"display:block; width:100%; height:100%;\"><img src=\"images/img_1.png\" alt=\"写真A\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;  border-radius: 8px;\"></a><div style=\"position:absolute; inset:0; background: linear-gradient(180deg, #000000, #ffffff); mix-blend-mode:multiply; pointer-events:none;\"></div></div>\n    \n    <img id=\"img2\" src=\"images/img_2.jpg\" alt=\"写真B\" class=\"el-img2\" style=\"position: absolute; box-sizing: border-box; background-color: transparent; color: inherit; text-align: left; font-family: sans-serif; width: 100%; height: 100%; object-fit: contain; display: block; \">\n    \n    <div id=\"btnlink\" class=\"el-btnlink\" style=\"position: absolute; box-sizing: border-box; background-color: #0ea5e9; color: #ffffff; text-align: center; font-family: sans-serif; background:none;\">\n        <a href=\"https://example.com/more\" style=\"margin: 0; position: absolute; width: 100%; height: 100%; display:block; text-decoration:none;\">\n            <button type=\"button\" style=\"width: 100%; height: 100%; box-sizing: border-box; background-color: #0ea5e9; color: #ffffff; font-size: inherit; border: none; border-radius: 10px; cursor: pointer; font-weight: 700; text-align: center; \">詳しく見る</button>\n        </a>\n    </div>\n    \n    <div id=\"ti1\" class=\"el-ti1\" style=\"position:absolute;\"><input type=\"email\" name=\"email\" placeholder=\"メール &amp;amp; 連絡先\" required style=\"position: absolute; box-sizing: border-box; background-color: transparent; color: inherit; text-align: left; font-family: sans-serif;  padding: 10px; border: 1px solid #ccc; border-radius: 4px; background-color: #fff; width: 100%; height: 100%;\"></div>\n    \n    <div id=\"ta1\" class=\"el-ta1\" style=\"position:absolute;\"><textarea name=\"message\" placeholder=\"本文&amp;lt;ここ&amp;gt;\" style=\"position: absolute; box-sizing: border-box; background-color: transparent; color: inherit; text-align: left; font-family: sans-serif;  padding: 10px; border: 1px solid #ccc; border-radius: 4px; background-color: #fff; width: 100%; height: 100%; resize: none; font-family: inherit;\"></textarea></div>\n    \n    <div id=\"btnsubmit\" class=\"el-btnsubmit\" style=\"position: absolute; box-sizing: border-box; background-color: #16a34a; color: #ffffff; text-align: center; font-family: sans-serif; background:none;\">\n        <button type=\"submit\" style=\"width: 100%; height: 100%; box-sizing: border-box; background-color: #16a34a; color: #ffffff; font-size: inherit; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; text-align: center; box-shadow: inset 3px 3px 6px rgba(255, 255, 255, 0.5), inset -3px -3px 6px rgba(0, 0, 0, 0.5); margin: 0; position: absolute; width: 100%; height: 100%;\">送信する</button>\n    </div>\n    \n    <div id=\"grp1\" class=\"el-grp1\" style=\"position: absolute; box-sizing: border-box; background-color: #0f172a;\">\n        \n        <div id=\"grpchild1\" class=\"el-grpchild1\" style=\"position: absolute; box-sizing: border-box; background-color: transparent; color: #a3e635; text-align: left; font-family: Yusei Magic;  display: block; overflow: hidden;  font-weight: normal;\">グループ内テキスト</div>\n    </div>\n    \n    <div id=\"slider1\" class=\"swiper el-slider1\" style=\"position: absolute; box-sizing: border-box; background-color: transparent; color: inherit; text-align: left; font-family: sans-serif;  border-radius: 5px; overflow:hidden;\">\n        <div class=\"swiper-wrapper\">\n            <div class=\"swiper-slide\" style=\"position:relative; background:#222;\">\n                <a href=\"https://example.com/s1\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"display:block; width:100%; height:100%; text-decoration:none; color:inherit;\">\n                    <img src=\"images/img_1.png\" style=\"width:100%; height:100%; object-fit:cover; display:block;\">\n                    <div style=\"position:absolute; left:0; right:0; bottom:0; padding:16px 20px; background:linear-gradient(transparent, rgba(0,0,0,0.7)); color:#fff;\">\n                        <div style=\"font-size:18px; font-weight:bold; margin-bottom:4px;\">スライド一</div>\n                        <div style=\"font-size:13px; opacity:0.9;\">説明&lt;one&gt;</div>\n                    </div>\n                </a>\n            </div>\n            <div class=\"swiper-slide\" style=\"position:relative; background:#222;\">\n                <a href=\"about.html\" style=\"display:block; width:100%; height:100%; text-decoration:none; color:inherit;\">\n                    <img src=\"data:image/webp;base64,UklGRh4AAABXRUJQ\" style=\"width:100%; height:100%; object-fit:cover; display:block;\">\n                    <div style=\"position:absolute; left:0; right:0; bottom:0; padding:16px 20px; background:linear-gradient(transparent, rgba(0,0,0,0.7)); color:#fff;\">\n                        <div style=\"font-size:18px; font-weight:bold; margin-bottom:4px;\">スライド二</div>\n                    </div>\n                </a>\n            </div>\n        </div>\n        <div class=\"swiper-pagination\"></div>\n        <div class=\"swiper-button-prev\"></div>\n        <div class=\"swiper-button-next\"></div>\n    </div>\n    \n    <div id=\"grid1\" class=\"el-grid1\" style=\"position: absolute; box-sizing: border-box; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; padding: 0; box-sizing: border-box; align-items: start;\">\n        <a href=\"https://example.com/a1\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"text-decoration: none; color: inherit; display: block; height:100%;\" class=\"article-card\" style=\"position: relative; background: #ffffff; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06); transition: transform 0.2s, box-shadow 0.2s; height:100%; cursor: pointer;\"><div style=\"width:100%; aspect-ratio: 16/10; overflow:hidden;\"><img src=\"images/img_1.png\" style=\"width:100%; height:100%; object-fit:cover; display:block;\" alt=\"記事1\"></div><div style=\"padding: 18px 20px 50px 20px;\"><div style=\"font-size: 17px; font-weight: bold; color: #222; margin-bottom: 10px; line-height: 1.4;\">記事1</div><div style=\"font-size: 13px; color: #666; line-height: 1.6;\">本文1</div></div><div style=\"position:absolute; right:14px; bottom:14px; width:36px; height:36px; background:#27ae60; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:18px; line-height:1;\">→</div></a>\n        <div  class=\"article-card\" style=\"position: relative; background: #ffffff; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06); transition: transform 0.2s, box-shadow 0.2s; height:100%; \"><div style=\"padding: 18px 20px 50px 20px;\"><div style=\"font-size: 17px; font-weight: bold; color: #222; margin-bottom: 10px; line-height: 1.4;\">記事2</div><div style=\"font-size: 13px; color: #666; line-height: 1.6;\">本文2</div></div></div>\n    </div>\n    \n    <div id=\"grid2\" class=\"swiper el-grid2\" style=\"position: absolute; box-sizing: border-box; padding: 0 44px;\">\n        <div class=\"swiper-wrapper\" style=\"padding-bottom:4px;\">\n            <div class=\"swiper-slide\" style=\"height:auto;\"><a href=\"index.html\" style=\"text-decoration: none; color: inherit; display: block; height:100%;\" class=\"article-card\" style=\"position: relative; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06); transition: transform 0.2s, box-shadow 0.2s; height:100%; cursor: pointer;\"><div style=\"padding: 18px 20px 50px 20px;\"><div style=\"font-size: 17px; font-weight: bold; color: #222; margin-bottom: 10px; line-height: 1.4;\">S1</div><div style=\"font-size: 13px; color: #666; line-height: 1.6;\">t1</div></div><div style=\"position:absolute; right:14px; bottom:14px; width:36px; height:36px; background:#27ae60; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:18px; line-height:1;\">→</div></a></div>\n            <div class=\"swiper-slide\" style=\"height:auto;\"><div  class=\"article-card\" style=\"position: relative; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06); transition: transform 0.2s, box-shadow 0.2s; height:100%; \"><div style=\"padding: 18px 20px 50px 20px;\"><div style=\"font-size: 17px; font-weight: bold; color: #222; margin-bottom: 10px; line-height: 1.4;\">S2</div><div style=\"font-size: 13px; color: #666; line-height: 1.6;\">t2</div></div></div></div>\n        </div>\n        <div class=\"swiper-button-prev\" style=\"color:#27ae60;\"></div>\n        <div class=\"swiper-button-next\" style=\"color:#27ae60;\"></div>\n    </div>\n    \n    <div id=\"acc1\" class=\"accordion el-acc1\" style=\"position: absolute; box-sizing: border-box; background:transparent;\">\n        <div class=\"acc-item\" style=\"border:1px solid #e0e0e0; border-radius:6px; margin-bottom:8px; overflow:hidden;\">\n            <button class=\"acc-header\" aria-expanded=\"true\" style=\"width:100%; text-align:left; padding:16px 20px; background:#f7f9fa; color:#2c3e50; border:none; font-size:16px; font-weight:bold; cursor:pointer; display:flex; justify-content:space-between; align-items:center;\">\n                <span>質問1</span>\n                <span class=\"acc-icon\" style=\"transition:transform 0.3s; transform:rotate(180deg);\">▼</span>\n            </button>\n            <div class=\"acc-body\" style=\"max-height:500px; overflow:hidden; transition:max-height 0.3s ease;\">\n                <div style=\"padding:16px 20px; color:#555555; font-size:14px; line-height:1.7;\">回答1<br>改行あり</div>\n            </div>\n        </div>\n        <div class=\"acc-item\" style=\"border:1px solid #e0e0e0; border-radius:6px; margin-bottom:8px; overflow:hidden;\">\n            <button class=\"acc-header\" aria-expanded=\"false\" style=\"width:100%; text-align:left; padding:16px 20px; background:#f7f9fa; color:#2c3e50; border:none; font-size:16px; font-weight:bold; cursor:pointer; display:flex; justify-content:space-between; align-items:center;\">\n                <span>質問2 &amp; &lt;em&gt;</span>\n                <span class=\"acc-icon\" style=\"transition:transform 0.3s; transform:rotate(0deg);\">▼</span>\n            </button>\n            <div class=\"acc-body\" style=\"max-height:0; overflow:hidden; transition:max-height 0.3s ease;\">\n                <div style=\"padding:16px 20px; color:#555555; font-size:14px; line-height:1.7;\">回答2</div>\n            </div>\n        </div>\n    </div>\n</form>\n\n</div>\n<iframe name=\"ksb_form_target\" style=\"display:none\"></iframe>\n<div id=\"ksb-form-success\" style=\"display:none; position:fixed; inset:0; align-items:center; justify-content:center; background:rgba(0,0,0,0.5); z-index:9999;\"><div style=\"background:#fff; padding:24px 32px; border-radius:10px; font-size:16px; color:#222; box-shadow:0 10px 40px rgba(0,0,0,0.3); max-width:80%; text-align:center;\">送信&lt;完了&gt;しました<br><button type=\"button\" onclick=\"document.getElementById('ksb-form-success').style.display='none'\" style=\"margin-top:16px; padding:8px 20px; border:none; border-radius:6px; background:#007acc; color:#fff; cursor:pointer;\">OK</button></div></div>\n<script src=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js\"></script>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    \n    var el_btnlink = document.getElementById(\"btnlink\");\n    if (el_btnlink) {\n        el_btnlink.addEventListener(\"mouseenter\", function(e) {\n            e.preventDefault();\n            alert(\"ようこそ\\\"ラボ\\\"へ\");\n        });\n    }\n    \n        if (typeof Swiper !== 'undefined') {\n            new Swiper('#slider1', {\n                speed: 500,\n                loop: true,\n                slidesPerView: 1,\n                effect: 'coverflow',\n                coverflowEffect: { rotate: 30, stretch: 0, depth: 100, modifier: 1, slideShadows: true },\n                autoplay: { delay: 2500, disableOnInteraction: false },\n                pagination: { el: '#slider1 .swiper-pagination', clickable: true },\n                navigation: { nextEl: '#slider1 .swiper-button-next', prevEl: '#slider1 .swiper-button-prev' }\n            });\n        }\n    \n        if (typeof Swiper !== 'undefined') {\n            new Swiper('#grid2', {\n                slidesPerView: 3,\n                spaceBetween: 20,\n                loop: true,\n                autoplay: { delay: 4000, disableOnInteraction: false },\n                navigation: { nextEl: '#grid2 .swiper-button-next', prevEl: '#grid2 .swiper-button-prev' },\n                breakpoints: { 0: { slidesPerView: 1 }, 600: { slidesPerView: 2 }, 900: { slidesPerView: 3 } }\n            });\n        }\n    \n        (function() {\n            var acc = document.getElementById('acc1');\n            if (!acc) return;\n            acc.querySelectorAll('.acc-header').forEach(function(btn) {\n                btn.addEventListener('click', function() {\n                    var body = btn.nextElementSibling;\n                    var icon = btn.querySelector('.acc-icon');\n                    var isOpen = btn.getAttribute('aria-expanded') === 'true';\n                    if (isOpen) {\n                        body.style.maxHeight = '0';\n                        btn.setAttribute('aria-expanded', 'false');\n                        if (icon) icon.style.transform = 'rotate(0deg)';\n                    } else {\n                        body.style.maxHeight = body.scrollHeight + 'px';\n                        btn.setAttribute('aria-expanded', 'true');\n                        if (icon) icon.style.transform = 'rotate(180deg)';\n                    }\n                });\n            });\n        })();\n});\n</script>\n\n</body>\n</html>"
