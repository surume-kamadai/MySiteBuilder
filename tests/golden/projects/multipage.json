{
  "settings": {
    "projectName": "複数ページサイト",
    "canvas": { "width": 800, "height": 600, "mobileWidth": 375, "mobileHeight": 800 },
    "outputType": "laravel",
    "siteBgColor": "#f1f2f6",
    "separateCss": false,
    "seo": { "siteName": "会社サイト", "lang": "ja", "description": "共通説明", "ogImage": "" }
  },
  "folders": [
    { "id": "f_blog", "name": "blog" }
  ],
  "pages": [
    {
      "id": "p_index", "name": "index", "folderId": null, "bgColor": "#ffffff",
      "seo": { "title": "トップ", "description": "", "ogImage": "" },
      "elements": [
        {
          "id": "h1", "type": "Label",
          "transform": { "x": 20, "y": 20, "width": 300, "height": 50 },
          "properties": { "text": "ようこそ", "color": "#111111", "fontsize": 28, "fontfamily": "Noto Serif JP" }
        },
        {
          "id": "toabout", "type": "Button",
          "transform": { "x": 20, "y": 90, "width": 140, "height": 44 },
          "properties": { "text": "会社案内へ", "role": "link", "route": "about.html", "bgcolor": "#2563eb", "color": "#fff" }
        }
      ]
    },
    {
      "id": "p_about", "name": "about", "folderId": null, "bgColor": "#eef2ff",
      "seo": { "title": "  会社案内  ", "description": "  会社の説明  ", "ogImage": "https://example.com/about.png" },
      "elements": [
        {
          "id": "ab1", "type": "Label",
          "transform": { "x": 20, "y": 20, "width": 400, "height": 40 },
          "properties": { "text": "会社案内", "color": "#1e3a8a", "fontsize": 24 }
        },
        {
          "id": "ab_ti", "type": "TextInput",
          "transform": { "x": 20, "y": 80, "width": 260, "height": 40 },
          "properties": { "inputName": "name", "inputType": "text", "required": true, "text": "お名前" }
        },
        {
          "id": "ab_submit", "type": "Button",
          "transform": { "x": 20, "y": 130, "width": 140, "height": 44 },
          "properties": { "text": "問い合わせ", "role": "submit", "route": "#", "successMessage": "受け付けました" }
        }
      ]
    },
    {
      "id": "p_post1", "name": "post1", "folderId": "f_blog", "bgColor": "#ffffff",
      "seo": { "title": "記事1", "description": "記事1の説明", "ogImage": "" },
      "elements": [
        {
          "id": "post_h", "type": "Label",
          "transform": { "x": 20, "y": 20, "width": 400, "height": 40 },
          "properties": { "text": "ブログ記事1", "color": "#0f172a", "fontsize": 22 }
        },
        {
          "id": "post_submit", "type": "Button",
          "transform": { "x": 20, "y": 80, "width": 160, "height": 44 },
          "properties": { "text": "コメント送信", "role": "submit", "route": "https://formspree.io/f/post1", "method": "POST" }
        }
      ]
    }
  ],
  "activePageId": "p_index"
}
